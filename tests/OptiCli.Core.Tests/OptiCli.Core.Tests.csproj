<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>Major</RollForward>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <!-- Direct reference for cross-checking the safety check against SqlClient's own parser. -->
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <!-- Fixture migrations for BuildScanner: real [Migration] and [DbContext] attributes, read as metadata only. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ground truth for JsonConfigFile: ASP.NET Core's own JSON configuration provider. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\OptiCli.Core\OptiCli.Core.csproj" />
  </ItemGroup>

</Project>
