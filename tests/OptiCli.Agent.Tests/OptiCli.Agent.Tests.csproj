<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Both agent builds: net8.0 runs against CMS 12, net10.0 against CMS 13 (Directory.Packages.props). -->
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RollForward>Major</RollForward>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- CMS 12.0's EPiServer.Framework asks for SqlClient 3.x (CMS 13.0's for 6.x); the tests never connect, so the newer one is fine. -->
    <NoWarn>$(NoWarn);NU1608</NoWarn>
    <!-- As in the agent: audit the direct references; with net10.0 the whole graph would be, CMS 12.0's old packages included. -->
    <NuGetAuditMode>direct</NuGetAuditMode>
  </PropertyGroup>

  <ItemGroup>
    <!-- Ground truth for the agent's own connection string parser; never used to connect. -->
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <!-- At runtime too, for the CMS options types the hosting startup configures (DataAccessOptions and co.); no CMS
         starts: the tests only build hosts and read options. -->
    <PackageReference Include="EPiServer.CMS.Core" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <DefineConstants>$(DefineConstants);CMS13</DefineConstants>
    <!-- As in the agent's CMS 13 build: CMS 12's site definition APIs are obsolete shims there, warnings until ported. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);CS0618</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\OptiCli.Agent\OptiCli.Agent.csproj" />
    <Compile Include="..\Shared\ConnectionStringCases.cs" Link="Shared\ConnectionStringCases.cs" />
  </ItemGroup>

</Project>
