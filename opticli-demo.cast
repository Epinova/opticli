[336.798104, "o", "{\"name\":\"Automatic Emptying of Trash\",\"schedule\":\"every 1 week\",\"nextRun\":\"2026-09-30T00:30:00Z\"}\r\n{\"name\":\"Change Log Auto Truncate\",\"schedule\":\"every 1 week\",\"nextRun\":\"2026-09-30T02:00:00Z\"}\r\n{\"name\":\"Monitored Tasks Auto Truncate\",\"schedule\":\"every 1 week\",\"nextRun\":\"2026-09-30T02:00:00Z\"}\r\n{\"name\":\"Notification Dispatcher\",\"schedule\":\"every 30 minutes\",\"nextRun\":\"2026-09-29T12:00:00Z\"}\r\n{\"name\":\"Notification Message Truncate\",\"schedule\":\"every 1 day\",\"nextRun\":\"2026-09-30T00:00:00Z\"}\r\n{\"name\":\"Optimizely Notifications\",\"schedule\":\"every 8 hours\",\"nextRun\":\"2026-09-29T16:00:00Z\"}\r\n{\"name\":\"Publish Delayed Content Versions\",\"schedule\":\"every 1 hour\",\"nextRun\":\"2026-09-29T12:00:00Z\"}\r\n{\"name\":\"Remove Abandoned BLOBs\",\"schedule\":\"every 1 week\",\"nextRun\":\"2026-09-30T01:30:00Z\"}\r\n{\"name\":\"Remove Permanent Editing\",\"schedule\":\"every 1 hour\",\"nextRun\":\"2026-09-29T12:00:00Z\"}\r\n{\"name\":\"Remove Unrelated Content Assets\",\"schedule\":\"every 1 week\",\"nextRun\":\"2026-09-30T01:00:00Z\"}\r\n{\"name\":\"Trim Content Versions\",\"schedule\":\"every 1 day\",\"nextRun\":\"2026-09-30T02:00:00Z\"}\r\n"]
