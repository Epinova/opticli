[397.673095, "o", "  \u001b[36m●\u001b[0m \u001b[1mSkill\u001b[0m \u001b[2mopticli\u001b[0m\r\n"]
[400.137403, "o", "  \u001b[36m●\u001b[0m \u001b[1mBash\u001b[0m \u001b[2mcd /demo/Alloy; opticli search \"Alloy Track whitepaper\" --in strings --limit 200; echo; opticli search \"Partners\" --in names --li\u001b[2m…\u001b[0m\r\n"]
[404.120009, "o", "  \u001b[36m●\u001b[0m \u001b[1mBash\u001b[0m \u001b[2mcd /demo/Alloy; opticli where-used 8 --pages --limit 200; echo; opticli access 1225; echo; opticli get 1225 --fields name; echo; \u001b[2m…\u001b[0m\r\n"]
[408.120009, "o", "  \u001b[36m●\u001b[0m \u001b[1mBash\u001b[0m \u001b[2mcd /demo/Alloy; opticli access 1228; echo; opticli versions 9 --limit 3; echo; opticli get 9 --fields MainContentArea; echo; opti\u001b[2m…\u001b[0m\r\n"]
[412.120009, "o", "\r\n  Two live pages promote the Alloy Track whitepaper (`/en/alloy-track/download-whitepaper-alloy-track/`, ref 8):\r\n"]
[412.120068, "o", "  \r\n  - **Alloy Track** (`/en/alloy-track/`) has the whitepaper page itself in its main content area, shown full width.\r\n  - **Alloy Meet** (`/en/alloy-meet/`) has the \"Alloy Track whitepaper teaser\" block (ref 1224), which is titled \"Plan less, ship more\" and links to the\r\n    whitepaper. It went live today.\r\n  \r\n  **Partners** (`/en/partners/`, ref 1225) can be read by any signed-in user (the Authenticated role). Administrators have full access. Anonymous visitors\r\n  can't see it, because the page doesn't inherit permissions from its parent; it has its own. Its only child page, \"Partner training\", uses the same rules.\r\n  \r\n  The Partners page also has the short address `/resellers`. That's close to the existing \"Find a reseller\" page, and anonymous visitors who follow it will be\r\n  blocked from the page.\r\n"]
