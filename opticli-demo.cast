[655.951889, "o", "  \u001b[36m●\u001b[0m \u001b[1mSkill\u001b[0m \u001b[2mopticli\u001b[0m\r\n"]
[658.588139, "o", "  \u001b[36m●\u001b[0m \u001b[1mBash\u001b[0m \u001b[2mcd /demo/Alloy; opticli search \"Alloy Track\" --in strings --limit 200; echo; opticli search \"whitepaper\" --in strings --limit 200\u001b[2m…\u001b[0m\r\n"]
[662.588139, "o", "  \u001b[36m●\u001b[0m \u001b[1mBash\u001b[0m \u001b[2mcd /demo/Alloy; opticli where-used 8 --pages --limit 200; echo; opticli where-used 1264 --pages --limit 200; echo; opticli where-\u001b[2m…\u001b[0m\r\n"]
[666.588139, "o", "  \u001b[36m●\u001b[0m \u001b[1mBash\u001b[0m \u001b[2mcd /demo/Alloy; for r in 7 9 1265 1264; do opticli versions $r --limit 3; echo; done; opticli get 7 --fields MainContentArea; ech\u001b[2m…\u001b[0m\r\n"]
[669.139468, "o", "  \u001b[36m●\u001b[0m \u001b[1mBash\u001b[0m \u001b[2mcd /demo/Alloy; opticli versions 7 --limit 3; echo; opticli versions 9 --limit 3; echo; opticli versions 1265 --limit 3; echo; op\u001b[2m…\u001b[0m\r\n"]
[673.139468, "o", "  \u001b[36m●\u001b[0m \u001b[1mBash\u001b[0m \u001b[2mcd /demo/Alloy; opticli tree 1265 --depth 3\u001b[0m\r\n"]
[675.648156, "o", "  \u001b[36m●\u001b[0m \u001b[1mBash\u001b[0m \u001b[2mcd /demo/Alloy; opticli access 1268\u001b[0m\r\n"]
[679.648156, "o", "\r\n  **Whitepaper:** two live pages promote the Alloy Track whitepaper.\r\n  - **Alloy Track** (page 7, /en/alloy-track/) puts the \"Whitepaper\" page (8) itself in its main content area, full width.\r\n"]
[679.648279, "o", "  - **Alloy Meet** (page 9, /en/alloy-meet/) has the \"Alloy Track whitepaper teaser\" block (1264) in its main content area.\r\n  \r\n  Both pages and the teaser are published, and nothing else links to the whitepaper page. The start page shows the general \"Alloy Track teaser\" block (38),\r\n  but that one is about the product, not the whitepaper.\r\n  \r\n"]
[679.64829, "o", "  **Partners section:** \"Partners\" (page 1265, /en/partners/) and its only child, \"Partner training\" (1268), have been live since today. Any signed-in user\r\n  (the Authenticated role) can read them, and Administrators have full access. Anonymous visitors can't see them. \"Partner training\" gets these rights from\r\n  \"Partners\".\r\n"]
[683.64829, "o", "\r\n   \u001b[1m\u001b[36mopticli\u001b[0m  ·  dotnet tool install -g OptiCli  ·  github.com/epinova/opticli  ·  MPL-2.0\r\n   \u001b[2mdoctor · type · get · where-used · jobs · trash · sql · export  |  serve · ide on · set · publish · apply · restore · types prune · sync pull · sync push\u001b[0m\r\n\r\n"]
