[335.683918, "o", "  \u001b[36m●\u001b[0m \u001b[1mSkill\u001b[0m \u001b[2mopticli\u001b[0m\r\n"]
[338.579896, "o", "  \u001b[36m●\u001b[0m \u001b[1mBash\u001b[0m \u001b[2mcd /demo/Alloy; opticli search \"Alloy Track whitepaper\" --in strings --limit 200; echo; opticli search \"Partners\" --in names --li\u001b[2m…\u001b[0m\r\n"]
[342.579896, "o", "  \u001b[36m●\u001b[0m \u001b[1mBash\u001b[0m \u001b[2mcd /demo/Alloy; opticli where-used 8 --pages --limit 200; echo; opticli access 231; echo; opticli get 231 --fields name; echo; op\u001b[2m…\u001b[0m\r\n"]
[346.579896, "o", "  \u001b[36m●\u001b[0m \u001b[1mBash\u001b[0m \u001b[2mcd /demo/Alloy; opticli get 230; echo; opticli get 9 --fields MainContentArea; echo; opticli versions 9 --limit 3; echo; opticli \u001b[2m…\u001b[0m\r\n"]
[350.579896, "o", "\r\n"]
[350.579963, "o", "  Two live pages promote the whitepaper (`/en/alloy-track/download-whitepaper-alloy-track/`, ref 8):\r\n  \r\n"]
[350.580244, "o", "  - **Alloy Track** (`/en/alloy-track/`) links to the whitepaper page directly, full width, in its MainContentArea. This has been in place since 2021.\r\n"]
[350.580292, "o", "  - **Alloy Meet** (`/en/alloy-meet/`) shows the \"Alloy Track whitepaper teaser\" block (ref 230, \"Plan less, ship more\"), which links to the whitepaper. This\r\n    went live today at 05:22 UTC. Both the block and the page version showing it are published.\r\n  \r\n  The **Partners** section (`/en/partners/`, ref 231, also reachable at `/resellers`) is published. It has its own access rights rather than inheriting them:\r\n  the **Authenticated** role can read it and **Administrators** have full access. Anonymous visitors don't have access, so they can't see it. Its only child\r\n  page, \"Partner training\", inherits those same rights.\r\n"]
[354.580292, "o", "\u001b[32m\u001b[1m/demo/Alloy\u001b[0m \u001b[36m❯\u001b[0m o"]
